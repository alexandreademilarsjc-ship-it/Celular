# Credenciais da Meta Cloud API (mesmas do script de campanha)
META_ACCESS_TOKEN=coloque_seu_token_de_acesso_aqui
META_PHONE_NUMBER_ID=coloque_o_phone_number_id_aqui
META_API_VERSAO=v21.0

# Segredo do app (Configurações Básicas do app no developers.facebook.com) —
# usado para validar que o webhook realmente veio da Meta. Sem isso, qualquer
# um que descobrir a URL pode enviar payloads falsos.
META_APP_SECRET=coloque_o_app_secret_aqui

# Token que você escolhe (qualquer string secreta) — configurado também na
# tela de configuração do Webhook no developers.facebook.com
WEBHOOK_VERIFY_TOKEN=escolha_uma_string_secreta_aqui

# Chave da API da Anthropic
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
MODELO_IA=claude-opus-5

# Número (com DDI, só dígitos) que recebe o aviso de lead quente
TELEFONE_ALEXANDRE=coloque_seu_numero_aqui
